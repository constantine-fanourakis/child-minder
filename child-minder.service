[Unit]
Description=Child Minder - Process Monitor and Control Service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/bin
ExecStart=/usr/bin/python3 /usr/bin/child-minder.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/child-minder /var/log/child-minder /etc/child-minder

[Install]
WantedBy=multi-user.target
