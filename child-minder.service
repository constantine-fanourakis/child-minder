[Unit]
Description=Child Minder - Process Monitor and Control Service
After=network.target

[Service]
# The daemon reports READY=1 once its signal handlers are installed; before
# that, the SIGHUP of a reload would terminate it.
Type=notify
NotifyAccess=main
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/lib/child-minder/child-minder.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
# PrivateTmp gives the service its own empty /tmp, without /tmp/.X11-unix, so anything
# started from here must reach the desktop over the session bus in /run/user,
# not over an X11 socket.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# Account changes run through systemd-run as transient units outside this
# sandbox, so /etc stays read-only here.
ReadWritePaths=/var/lib/child-minder /var/log/child-minder

[Install]
WantedBy=multi-user.target
