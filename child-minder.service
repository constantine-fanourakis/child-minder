[Unit]
Description=Child Minder - Process Monitor and Control Service
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/lib/child-minder/child-minder.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
# PrivateTmp hides /tmp/.X11-unix from helpers launched for a user, so anything
# started from here must reach the desktop over the session bus in /run/user,
# not over an X11 socket.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# /etc is writable because re-enabling a timed account disable runs usermod,
# which rewrites the shadow database and takes lock files alongside it.
ReadWritePaths=/var/lib/child-minder /var/log/child-minder /etc

[Install]
WantedBy=multi-user.target
